# Player vs zombie: attack packets, damage_event/hurt_animation/entity_event, knockback motion, death. Also the zombie hitting the bot.
cmd gamerule advance_time false
cmd gamerule spawn_mobs false
cmd gamerule mob_drops false
cmd difficulty normal
cmd time set 18000
cmd kill @e[type=!minecraft:player]
cmd gamemode survival @s
cmd give @s minecraft:iron_sword
cmd tp @s 0.5 -60 0.5 -90 0
wait_ticks 5
cmd summon minecraft:zombie 2.5 -60 0.5 {NoAI:1b,PersistenceRequired:1b}
wait_entity zombie
wait_ticks 5
look_at 2.5 -59.5 0.5
attack zombie#1
wait_ticks 12
observe after_first_hit
attack zombie#1
wait_ticks 12
attack zombie#1
wait_ticks 30
observe after_three_hits
# now a hostile one with AI
cmd summon minecraft:zombie 6.5 -60 0.5 {PersistenceRequired:1b}
wait_ticks 120
observe zombie_ai
