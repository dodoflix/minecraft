# enable-code-of-conduct: the client shows the text, we acknowledge it and join.
server enable-code-of-conduct=true
file codeofconduct/en_us.txt fixtures/codeofconduct/en_us.txt
file codeofconduct/de_de.txt fixtures/codeofconduct/de_de.txt
client join
wait_screen CodeOfConductScreen 120
snapshot screen
ctl {"cmd": "widgetClick", "key": "gui.acknowledge"}
wait_screen null 120
wait_state chunks >= 117 and ticks_in_level >= 100 60
client disconnect
wait_screen TitleScreen 30
