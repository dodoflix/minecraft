# Five reconnects: each reaches the world again.
server seed=12345
client join
wait_screen null 120
# 117 = the chunks of view distance 4 (the runner default)
wait_state chunks >= 117 and ticks_in_level >= 100 60
client rejoin
wait_screen null 120
wait_state chunks >= 117 and ticks_in_level >= 40 60
client rejoin
wait_screen null 120
wait_state chunks >= 117 and ticks_in_level >= 40 60
client rejoin
wait_screen null 120
wait_state chunks >= 117 and ticks_in_level >= 40 60
client rejoin
wait_screen null 120
wait_state chunks >= 117 and ticks_in_level >= 40 60
client rejoin
wait_screen null 120
wait_state chunks >= 117 and ticks_in_level >= 40 60
snapshot after
client disconnect
wait_screen TitleScreen 30
