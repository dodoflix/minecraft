# Overworld terrain of a seeded default world at two spots: chunk count, block columns, biomes and the entities the world holds.
# Both servers run the same 1200 ticks with random ticks off before the join. Two vanilla servers still differ in the loose
# item entities of the second spot (items dropped by blocks that generation leaves unsupported: their number and the random
# spread of each drop), so item entities are left out; every other entity, entity packet and falling block is compared.
# There is no screenshot: two vanilla servers place the leaves of border trees differently.
server seed=12345 level-type=minecraft:normal
console gamerule random_tick_speed 0
console tick sprint 1200
ignore entities[minecraft:item]
client join
wait_screen null 120
wait_state chunks >= 117 and ticks_in_level >= 100 60
console gamemode spectator Steve
console tp Steve 0 110 0 0 25
wait_state ticks_in_level >= 400 60
ctl {"cmd": "probe", "spec": {"blocks": [[0,40,0,0,130,0], [24,40,-9,24,130,-9], [-30,40,17,-30,130,17], [40,40,40,40,130,40]], "biomes": [[0,64,0], [24,64,-9], [-30,64,17], [40,64,40]]}}
snapshot spot1
console tp Steve 700 120 -300 90 30
wait_state ticks_in_level >= 800 60
ctl {"cmd": "probe", "spec": {"blocks": [[700,40,-300,700,140,-300], [712,40,-290,712,140,-290], [690,40,-310,690,140,-310]], "biomes": [[700,64,-300], [712,64,-290], [690,64,-310]]}}
snapshot spot2
client disconnect
wait_screen TitleScreen 30
