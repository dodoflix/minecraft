# One of every living entity type in a grid, no AI, invulnerable, at night, 100 server ticks after the summons (the server
# is frozen before them and sprints exactly that many ticks, so no run depends on client timing): the client's entity list with every synched value,
# equipment, attributes and effects, and a screenshot from above the grid.
# The floor is stone: a horse on grass starts eating at random (one tick in 300, unseeded), which sets a synched flag.
server seed=12345
tolerate level.day_time 0
# Resting armor stands and mannequins show the client's own tick phase (two vanilla servers differ the same way).
tolerate entities.*.motion.1 0.02
client join
wait_screen null 120
wait_state chunks >= 117 and ticks_in_level >= 100 60
console tick freeze
console time set 18000
console gamemode spectator Steve
console tp Steve 22 -20 20 0 60
console fill -2 -61 -2 44 -61 64 minecraft:stone
console summon minecraft:allay 0.5 -60 0.5 {NoAI:1b,Silent:1b,Invulnerable:1b,PersistenceRequired:1b}
console summon minecraft:armadillo 4.5 -60 0.5 {NoAI:1b,Silent:1b,Invulnerable:1b,PersistenceRequired:1b}
console summon minecraft:armor_stand 8.5 -60 0.5 {NoAI:1b,Silent:1b,Invulnerable:1b,PersistenceRequired:1b}
