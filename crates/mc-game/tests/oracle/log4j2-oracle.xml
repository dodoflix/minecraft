<?xml version="1.0" encoding="UTF-8"?>
<!-- vanilla log noise goes to stderr so stdout stays the fixture -->
<Configuration status="WARN">
  <Appenders><Console name="E" target="SYSTEM_ERR"><PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level]: %msg%n"/></Console></Appenders>
  <Loggers><Root level="warn"><AppenderRef ref="E"/></Root></Loggers>
</Configuration>
