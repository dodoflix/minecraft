# Shape recipes + queries interpreted by BOTH ShapesOracle.java (vanilla) and tests/shapes.rs.
# Regenerate expected output: scripts/vanilla-java.sh crates/mc-core/tests/fixtures/shapes/ShapesOracle.java crates/mc-core/tests/fixtures/shapes/shapes.script > crates/mc-core/tests/fixtures/shapes/shapes.out
empty E
block B
infinity INF
box slab 0 0 0 1 0.5 1
box top_slab 0 0.5 0 1 1 1
box step 0 0.5 0 1 1 0.5
or stair slab step
box post 0.375 0 0.375 0.625 1 0.625
box arm_n 0.4375 0.375 0 0.5625 0.5625 0.375
box arm_n_hi 0.4375 0.75 0 0.5625 0.9375 0.375
box arm_e 0.625 0.375 0.4375 1 0.5625 0.5625
box arm_e_hi 0.625 0.75 0.4375 1 0.9375 0.5625
or fence post arm_n arm_n_hi arm_e arm_e_hi
box thin 0.3 0 0.3 0.7 1 0.7
box odd 0.1 0.1 0.1 0.9 0.9 0.9
box third 0 0 0 0.3333333333333333 1 1
box cauldron_in 0.125 0.25 0.125 0.875 1 0.875
box cauldron_out 0 0 0 1 1 1
join cauldron cauldron_out cauldron_in ONLY_FIRST
box wall_post 0.25 0 0.25 0.75 1 0.75
box wall_side 0.3125 0 0 0.6875 0.8125 0.5
or wall wall_post wall_side
box fine 0.0625 0.0625 0.0625 0.9375 0.5 0.5
box hopper_top 0 0.625 0 1 0.6875 1
box hopper_wall 0 0.6875 0 0.125 1 1
or hopper hopper_top hopper_wall
create tiny 0 0 0 0.00000001 1 1
create above 0 0 0 1 1.5 1
box q 0.5 0.5 0.5 1 1 1
box g_lo 0 0 0 0.5 0.5 0.5
box g_hi 0.5 0.5 0.5 1 1 1
or gap g_lo g_hi
box far 2 2 2 3 3 3
or two_far slab far
box offset_big 1.25 -0.5 3 4.5 0.5 5.7
move slab_m slab 0.25 0 0
move stair_m stair 0.5 0.25 -0.125
move fence_m fence 0.1 0 0.3
move B_m B 1 2 3
move odd_m odd -0.3 0.7 0.1
move stair_mm stair_m 0.1 0.2 0.3
join j_and stair top_slab AND
join j_or stair fence OR
join j_xor stair fence NOT_SAME
join j_only_first stair step ONLY_FIRST
join j_only_second B stair ONLY_SECOND
join j_same_diff slab slab_m ONLY_FIRST
join j_odd odd thin OR
join j_odd2 odd fence NOT_SAME
join j_third third thin OR
join j_third2 third odd ONLY_FIRST
join j_moved stair_m fence_m OR
join j_moved2 stair_mm stair ONLY_FIRST
join j_far two_far B OR
join j_far2 far slab NOT_SAME
joinu u_or stair fence OR
joinu u_xor stair top_slab NOT_SAME
joinu u_odd odd thin OR
opt o_u_or u_or
opt o_fence fence
single s_fence fence
single s_odd odd
single s_E E
face f_stair_up stair UP
face f_stair_down stair DOWN
face f_stair_north stair NORTH
face f_stair_south stair SOUTH
