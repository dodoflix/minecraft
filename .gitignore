# Rust build output (workspace target/, and stray crate-local target/ dirs)
/target/
/crates/*/target/
/tools/*/target/
**/*.rs.bk

# Vanilla reference material (decompiled source, jars, datagen/extractor output); recreate with scripts/setup-ref.sh
/ref

# Left behind by the vanilla bundler when a script runs it from the repo root
/libraries/
/versions/

# Local server/client runs (vanilla oracle, real client cache, E2E scratch worlds)
/run
logs/
*.log
crash-reports/

# Python bytecode
__pycache__/
*.pyc

# Java tooling build output
/tools/extractor/build
*.class

# IDE / OS
.idea/
.vscode/
*.iml
*.swp
*~
.DS_Store
